appname               = diskwakemonitor
version               = 1.3.0
display_name          = 硬盘唤醒归因
desc                  = 记录是哪个进程访问了磁盘，查清机械硬盘被什么唤醒。<br>唤醒判定（/proc/diskstats）+ 电源态确认（SMART）+ 进程归因（内建 fanotify，覆盖容器），带 Web 面板与命令行。只读诊断，不修改任何数据。
platform              = x86
source                = thirdparty
maintainer            = disk-wake-monitor
distributor           = disk-wake-monitor
os_min_version        = 0.9.0

# ---- 运行控制 ----
install_type          = root
service_port          = 8765
checkport             = true
ctl_stop              = true

# ---- 桌面入口 ----
desktop_uidir         = ui
desktop_applaunchname = diskwakemonitor.Application

