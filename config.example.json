{
  "data_dir": "/var/lib/disk-wake-monitor",
  "retention_hours": 168,

  "host": "127.0.0.1",
  "port": 8765,
  "auth_token": "",

  "poll_interval": 1.0,
  "idle_threshold_seconds": 120.0,
  "smart_interval": 60.0,
  "smart_enabled": true,
  "assume_sleep_on_idle": false,

  "fatrace_enabled": true,
  "fatrace_filter": "OCW",
  "blockdump_fallback": true,
  "blockdump_enabled": false,

  "monitor_only_sleepable": true,
  "monitor_devices": [],
  "exclude_devices": [],

  "suspect_lookback_seconds": 5.0,
  "suspect_lookahead_seconds": 3.0,
  "dedupe_window_seconds": 10.0,
  "ring_buffer_size": 20000,

  "log_level": "INFO"
}
